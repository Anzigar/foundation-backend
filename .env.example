# Environment Configuration Template
# Copy this file to .env.development or .env.production and configure values

# Basic Configuration
DEBUG=true
ENVIRONMENT=development
SECRET_KEY=your-secret-key-here

# API Configuration
API_PREFIX=/api/v1
API_VERSION=1.0.0
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT Authentication
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration - PostgreSQL
POSTGRES_USER=foundation_user
POSTGRES_PASSWORD=foundation_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=foundation_db
DATABASE_URL=postgresql://foundation_user:foundation_pass@localhost:5432/foundation_db

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET_NAME=your-s3-bucket-name
AWS_S3_REGION=us-east-2

# Performance Settings
WORKERS=1

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=logs/app.log
